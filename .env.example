# MongoDB connection string.
# Local development can use "memory" for a temporary database that disappears when the API stops.
# Production should be a MongoDB Atlas URI. Allow Vercel to connect (Atlas Network Access 0.0.0.0/0,
# unless you use a private endpoint).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/align

# Long random string used to sign the session cookie. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# Client only. Uncomment to use the localStorage mock instead of this API (no database required).
# Vite reads this from the repo root .env file.
# VITE_API=mock
